# OMDB_API_KEY: The Open Movie Database (OMDb) API key
# Used server-side for movie lookups, IMDb ratings, runtimes, and posters.
OMDB_API_KEY="MY_OMDB_API_KEY"

# DATABASE_URL: Postgres connection string for the 20k-title movie database
# (Neon in prod). Must include ?sslmode=require for Neon. Server-side only —
# the full catalog lives here; no release or title search calls OMDb/TMDB.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# IP_HASH_SALT: salt used to hash IP addresses before persisting them for
# rate limiting / abuse counters. Any long random string; never commit the
# real one. Rotating it invalidates previously stored hashes.
IP_HASH_SALT="MY_IP_HASH_SALT"

# GEMINI_API_KEY: Optional Gemini API key for personalized movie reasoning.
# AI Studio automatically injects this at runtime from user secrets if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WATCHMODE_API_KEY: Watchmode API key for live "where to watch" streaming
# availability. Without it, picks fall back to the catalog's providers.
WATCHMODE_API_KEY="MY_WATCHMODE_API_KEY"

# WATCHMODE_REGION: Two-letter region for streaming availability (e.g. IN, US).
WATCHMODE_REGION="IN"

# TMDB_API_KEY: The Movie Database API key (v3). Legacy/discovery module
# fallback only — recommendations and title search are DB-first and do NOT
# need this key. Set ENABLE_TMDB="true" plus the key if you want the old
# TMDB discovery path.
# Get one free at https://www.themoviedb.org/settings/api (server-side only).
# ATTRIBUTION (required by TMDB ToS): "This product uses the TMDB API but is
# not endorsed or certified by TMDB." Respect ~40 requests/10s.
TMDB_API_KEY="MY_TMDB_API_KEY"
ENABLE_TMDB="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LEARNING_HMAC_SECRET: server secret that signs feedback-event tokens.
# Required when learning is on (any random string; never commit the real one).
LEARNING_HMAC_SECRET="MY_LEARNING_HMAC_SECRET"

# LEARNING_ENABLED: set to "false" to switch the learning layer off instantly.
# LEARNING_ENABLED="true"

# LEARNING_DB_PATH: override for the learning SQLite file (tests / manual runs).
# LEARNING_DB_PATH="./data/learning.db"

# SEMANTIC_ENABLED: keep "false" unless the benchmark checklist in
# server/semantic.js passes (model present, 0 new hard-constraint violations).
# SEMANTIC_ENABLED="false"
