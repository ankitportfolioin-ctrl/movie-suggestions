# OMDB_API_KEY: The Open Movie Database (OMDb) API key
# Used server-side for movie lookups, IMDb ratings, runtimes, and posters.
OMDB_API_KEY="MY_OMDB_API_KEY"

# GEMINI_API_KEY: Optional Gemini API key for personalized movie reasoning.
# AI Studio automatically injects this at runtime from user secrets if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WATCHMODE_API_KEY: Watchmode API key for live "where to watch" streaming
# availability. Without it, picks fall back to the catalog's providers.
WATCHMODE_API_KEY="MY_WATCHMODE_API_KEY"

# WATCHMODE_REGION: Two-letter region for streaming availability (e.g. IN, US).
WATCHMODE_REGION="IN"

# TMDB_API_KEY: The Movie Database API key (v3) used as the PRIMARY
# discovery source: broad candidate retrieval (title search with spelling
# tolerance, genre/mood/language/runtime discovery with pagination).
# Without it the site falls back to its built-in catalog (~30 titles).
# Get one free at https://www.themoviedb.org/settings/api (server-side only).
# ATTRIBUTION (required by TMDB ToS): "This product uses the TMDB API but is
# not endorsed or certified by TMDB." Posters must load from image.tmdb.org
# (this app builds URLs that way). Respect ~40 requests/10s; the app backs
# off to partial results on HTTP 429.
TMDB_API_KEY="MY_TMDB_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
