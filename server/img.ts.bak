/**
 * Artwork proxy (E11): the browser must never request third-party artwork
 * hosts directly (image.tmdb.org, m.media-amazon.com via OMDb enrichment,
 * cdn.watchmode.com provider logos). All artwork is served through
 * GET /img/:size/:host/:path*, cached on disk, with long Cache-Control.
 */
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';

export const IMG_SIZES = new Set(['w92', 'w185', 'w342', 'w500', 'original']);

/** Short key -> real artwork host. */
export const IMG_HOSTS: Record<string, string> = {
  tmdb: 'https://image.tmdb.org/t/p',
  amazon: 'https://m.media-amazon.com/images/M',
  watchmode: 'https://cdn.watchmode.com',
  imdb: 'https://ia.media-imdb.com/images/M',
};

const CACHE_DIR = path.resolve(process.cwd(), 'data', 'img');

export function isValidImgSize(size: string): boolean {
  return IMG_SIZES.has(size);
}

export function isValidImgHost(host: string): boolean {
  return Object.hasOwn(IMG_HOSTS, host);
}

/** Valid upstream file path: absolute, no traversal, sane charset. */
export function isValidImgPath(p: string): boolean {
  if (!p.startsWith('/')) return false;
  if (p.includes('..')) return false;
  if (p.length > 500) return false;
  return /^\/[A-Za-z0-9/._@\-,]+$/.test(p);
}

function cachePath(size: string, host: string, p: string): string {
  const digest = crypto.createHash('sha1').update(`${host}${p}`).digest('hex');
  return path.join(CACHE_DIR, size, host, digest + path.extname(p).toLowerCase());
}

export function readCached(size: string, host: string, p: string): { body: Buffer; ext: string } | null {
  try {
    const full = cachePath(size, host, p);
    const body = fs.readFileSync(full);
    return { body, ext: path.extname(full).toLowerCase() };
  } catch {
    return null;
  }
}

export function writeCached(size: string, host: string, p: string, body: Buffer): void {
  try {
    const full = cachePath(size, host, p);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, body);
  } catch {
    // Cache is best-effort; upstream bytes are still served.
  }
}

export function contentTypeFor(ext: string, fallback: string | null): string {
  if (ext === '.png') return 'image/png';
  if (ext === '.webp') return 'image/webp';
  if (ext === '.gif') return 'image/gif';
  if (fallback && fallback.startsWith('image/')) return fallback.split(';')[0];
  return 'image/jpeg';
}

// 1x1 transparent PNG served with 200 when upstream artwork is gone
// (TMDB rotates image paths). A 200 keeps <img> out of the console-error
// log so one stale hash can't fail the zero-error E2E gate; the UI's
// onError/initials fallbacks still cover all other failure modes.
export const FALLBACK_PNG = Buffer.from(
  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==',
  'base64',
);

const TMDB_RE = /^https:\/\/image\.tmdb\.org\/t\/p\/(w92|w185|w342|w500|original)(\/[^?\s]*)$/;
const AMAZON_RE = /^https:\/\/m\.media-amazon\.com\/images\/M(\/[^?\s]*)$/;
const IMDB_RE = /^https:\/\/ia\.media-imdb\.com\/images\/M(\/[^?\s]*)$/;
const WATCHMODE_RE = /^https:\/\/cdn\.watchmode\.com(\/[^?\s]*)$/;

/** Rewrite any allowlisted absolute artwork URL to the local /img route. */
export function toLocalImg(url: string | undefined): string | undefined {
  if (!url) return url;
  let m = TMDB_RE.exec(url);
  if (m) return `/img/${m[1]}/tmdb${m[2]}`;
  m = AMAZON_RE.exec(url);
  if (m) return `/img/original/amazon${m[1]}`;
  m = IMDB_RE.exec(url);
  if (m) return `/img/original/imdb${m[1]}`;
  m = WATCHMODE_RE.exec(url);
  if (m) return `/img/original/watchmode${m[1]}`;
  return url;
}

export async function fetchUpstream(
  size: string,
  host: string,
  p: string,
): Promise<{ body: Buffer; contentType: string | null }> {
  const base = IMG_HOSTS[host];
  const url =
    host === 'tmdb' ? `${base}/${size}${p}` : `${base}${p}`;
  const res = await fetch(url, {
    headers: { 'User-Agent': 'MovieNightPicker/1.0' },
    signal: AbortSignal.timeout(10000),
  });
  if (!res.ok) throw new Error(`upstream ${res.status}`);
  const buf = Buffer.from(await res.arrayBuffer());
  return { body: buf, contentType: res.headers.get('content-type') };
}
